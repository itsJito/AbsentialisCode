  "status": [
    {"name": "Hated", "min": -100, "max": -51, "text": "Hunt, deny service, attack when feasible"},
    {"name": "Hostile", "min": -50, "max": -11, "text": "Threats, refusal, suspicion; possible truce talks"},
    {"name": "Neutral", "min": -10, "max": 19, "text": "Cautious contact, basic trade or small tasks"},
    {"name": "Accepted", "min": 20, "max": 49, "text": "Better trade, information, safe passage, routine jobs"},
    {"name": "Trusted", "min": 50, "max": 74, "text": "Special jobs, limited support, access to protected areas"},
    {"name": "Alliance-eligible", "min": 75, "max": 100, "text": "Can negotiate a formal alliance if prerequisites hold"}
