    "charismatic": {"weights": {"bonds": 1.35, "reputation": 1.30, "profit": 1.05}, "risk": 0.0, "text": "people follow"},
    "vengeful":    {"weights": {"revenge": 1.40, "bonds": 1.10, "profit": 0.85}, "risk": 0.08, "text": "does not forget"},
    "pragmatic":   {"weights": {"profit": 1.25, "revenge": 0.70, "order": 1.05}, "risk": -0.05, "text": "deals with whoever pays"},
    "paranoid":    {"weights": {"security": 1.40, "bonds": 0.80, "profit": 0.90}, "risk": -0.10, "text": "trusts nobody twice"},
    "honorable":   {"weights": {"reputation": 1.35, "bonds": 1.20, "loot": 0.70}, "risk": 0.0, "text": "keeps a word given"},
