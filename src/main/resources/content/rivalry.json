    "groupsPerFaction": 2, "minSize": 10, "maxSize": 50,
    "hoursPerTick": 6, "logCap": 400, "memoryCap": 40, "pivotalSalience": 0.75, "aggregateBelow": 0.35,
    "rumourHops": 2, "rumourDelayTicks": 2, "rumourConfidence": 0.6, "rumourMinSalience": 0.4, "rumoursPerTick": 6,
    "relationDecayPerTick": 0.35, "hostilityDecayPerTick": 0.5, "fearDecayPerTick": 0.6,
